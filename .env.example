# RetailSense Environment Configuration

# Database Configuration:
# For local development with zero setup, SQLite is used by default:
DATABASE_URL=sqlite:///./retailsense.db

# For PostgreSQL (e.g. running locally or via Docker):
# DATABASE_URL=postgresql://retailsense_user:retailsense_password@localhost:5432/retailsense_db

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
PORT=8000
